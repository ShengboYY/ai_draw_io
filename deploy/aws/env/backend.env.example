# Runtime profile
SPRING_PROFILES_ACTIVE=prod
SPRING_CONFIG_IMPORT=optional:file:.env[.properties],classpath:agent/agent-draw-io.yml
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# Public origins. Use one shared domain behind ALB when possible.
APP_SECURITY_ALLOWED_ORIGINS=https://draw.example.com
ADMIN_ALLOWED_ORIGINS=https://draw.example.com
ADMIN_EMAILS=admin@example.com

# Links embedded in verification and password reset emails.
ACCOUNT_VERIFICATION_BASE_URL=https://draw.example.com/verify-email
ACCOUNT_PASSWORD_RESET_BASE_URL=https://draw.example.com/reset-password/confirm

# RDS MySQL connection. In ECS, put MYSQL_PASSWORD in Secrets Manager.
MYSQL_HOST=ai-drawio-prod.cluster-abcdefghijkl.ap-southeast-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=ai_draw_io
MYSQL_USER=ai_drawio_app
MYSQL_PASSWORD=replace-with-secrets-manager
MYSQL_TZ=UTC
MYSQL_POOL_MIN_IDLE=5
MYSQL_POOL_MAX_SIZE=20

# Standard Spring datasource variables keep ECS independent from gitignored profile files.
SPRING_DATASOURCE_URL=jdbc:mysql://ai-drawio-prod.cluster-abcdefghijkl.ap-southeast-2.rds.amazonaws.com:3306/ai_draw_io?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=UTC&sslMode=REQUIRED&allowPublicKeyRetrieval=false
SPRING_DATASOURCE_USERNAME=ai_drawio_app
SPRING_DATASOURCE_PASSWORD=replace-with-secrets-manager
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# Optional override when you mount the RDS CA bundle and want VERIFY_IDENTITY.
# SPRING_DATASOURCE_URL=jdbc:mysql://ai-drawio-prod.cluster-abcdefghijkl.ap-southeast-2.rds.amazonaws.com:3306/ai_draw_io?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&sslMode=VERIFY_IDENTITY&allowPublicKeyRetrieval=false

# LLM provider configuration. Store API keys in Secrets Manager.
LLM_BASE_URL=https://api.openai.com
LLM_COMPLETIONS_PATH=v1/chat/completions
LLM_EMBEDDINGS_PATH=v1/embeddings
LLM_MODEL=replace-with-approved-model
LLM_API_KEY=replace-with-secrets-manager
LLM_LANGCHAIN_BASE_URL=https://api.openai.com/v1

# Optional Baidu search MCP key used by agent-draw-io.yml.
BAIDU_SEARCH_API_KEY=replace-with-secrets-manager-or-remove

# Generate with: openssl rand -base64 32
MODEL_CREDENTIAL_ENCRYPTION_KEY=base64:replace-with-32-byte-base64
MODEL_CREDENTIAL_ENCRYPTION_KEY_ID=prod-2026-07

# PUBLIC skill creation token. Leave unset unless you need the admin API.
SKILL_ADMIN_TOKEN=replace-with-secrets-manager-or-remove

# Production visual review stays fail-open until explicitly promoted.
ZIPP_VISUAL_REVIEW_ENABLED=false
ZIPP_VISUAL_REVIEW_AUTO_REPAIR_ENABLED=false
ZIPP_VISUAL_REVIEW_DRAWER_AGENT_ID=300000
DRAWIO_SKILLS_DIR=
# V2 stays off until its migration release and production adapters are explicitly promoted.
TURN_ENGINE_LIFECYCLE_ENABLED=false
TURN_ENGINE_HTTP_V2_ENABLED=false
TURN_ENGINE_HTTP_V1_V2_BRIDGE_ENABLED=false
TURN_ENGINE_CANARY_ROLLOUT_PERCENT=0
TURN_ENGINE_MIGRATION_STARTUP_TARGET_MODE=
ZIPP_TURN_V2_DIRECT_GENERATION_ENABLED=false
ZIPP_TURN_V2_GROUNDED_GENERATION_ENABLED=false
ZIPP_TURN_V2_EVIDENCE_ANSWER_GENERATION_ENABLED=false
LOG_PATH=/tmp/ai-drawio-logs
