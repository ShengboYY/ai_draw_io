digraph MultimodalChainComparison {
  // The figure intentionally separates background ingestion from online turn execution.
  graph [
    rankdir=TB,
    bgcolor="#F7F9FC",
    pad="0.35",
    nodesep="0.28",
    ranksep="0.46",
    splines=ortho,
    newrank=true,
    fontname="Hiragino Sans GB",
    fontsize=26,
    fontcolor="#18212F",
    label="图片 / PDF 能力接入前后链路对比",
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontname="Hiragino Sans GB",
    fontsize=13,
    fontcolor="#18212F",
    margin="0.16,0.11",
    height=0.62
  ];

  edge [
    color="#64748B",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Hiragino Sans GB",
    fontsize=10,
    fontcolor="#475569"
  ];

  subgraph cluster_before {
    // Baseline: only a text prompt can become drawing context.
    label="A  未接入图片 / PDF 处理：单一路径";
    labelloc=t;
    labeljust=l;
    fontsize=19;
    fontcolor="#9F3F3A";
    color="#E8A39D";
    fillcolor="#FFF7F5";
    style="rounded,filled";
    penwidth=1.7;
    margin=22;

    b_user [label="用户文本指令", fillcolor="#FFFFFF", color="#D6AAA6"];
    b_admission [label="Chat API\nTurn Admission", fillcolor="#FFFFFF", color="#D6AAA6"];
    b_plan [label="意图判断\nPlain Plan", fillcolor="#FFFFFF", color="#D6AAA6"];
    b_draw [label="Drawer 生成\nDraw.io 操作", fillcolor="#FDE8E5", color="#C96D66"];
    b_commit [label="结构校验\nCanvas Commit", fillcolor="#FDE8E5", color="#C96D66"];
    b_review [label="画布渲染截图\nVLM Review / 最多一次安全修复", fillcolor="#FCE2DE", color="#B8554F"];
    b_result [label="可编辑画布", fillcolor="#FFFFFF", color="#D6AAA6"];

    { rank=same; b_user; b_admission; b_plan; b_draw; b_commit; b_review; b_result; }

    b_user -> b_admission -> b_plan -> b_draw -> b_commit -> b_review -> b_result [
      color="#B8554F"
    ];

    b_limit [
      shape=note,
      label="能力边界：附件不能成为执行上下文；无法解析 PDF、OCR 图片、还原流程图，也没有文件级来源引用。",
      fillcolor="#FFF0ED",
      color="#D9928B",
      fontcolor="#8C3B36",
      fontsize=11,
      margin="0.20,0.13"
    ];
    b_plan -> b_limit [style=dashed, arrowhead=none, color="#D9928B"];
  }

  subgraph cluster_after {
    // Added architecture: uploaded material is prepared once, then consumed through typed routes.
    label="B  接入图片 / PDF 处理：安全摄取 + 来源感知分流 + 原绘图闭环";
    labelloc=t;
    labeljust=l;
    fontsize=19;
    fontcolor="#245C93";
    color="#81ACD7";
    fillcolor="#F3F8FD";
    style="rounded,filled";
    penwidth=1.7;
    margin=22;

    subgraph cluster_ingestion {
      label="① 后台资料处理（上传一次，可重复检索）";
      labelloc=t;
      labeljust=l;
      fontsize=14;
      fontcolor="#8A5A14";
      color="#E5C07A";
      fillcolor="#FFFBF2";
      style="rounded,filled";
      penwidth=1.2;
      margin=16;

      a_upload [label="上传\nPDF / PNG / JPEG", fillcolor="#FFFDF7", color="#D9AD55"];
      a_quarantine [label="S3 Quarantine\n安全扫描 / 类型与限额校验", fillcolor="#FFF8E8", color="#D9AD55"];
      a_worker [label="Ingestion Worker\nPDFBox / OCR / 有限视觉分析", fillcolor="#FFF3D8", color="#CA8A21"];
      a_evidence [label="Evidence / Chunk\n页码・区域・来源锚点", fillcolor="#FFF8E8", color="#D9AD55"];
      a_store [label="MySQL + S3 + Pinecone\n事实源・原件・检索投影", fillcolor="#FFFDF7", color="#D9AD55"];

      { rank=same; a_upload; a_quarantine; a_worker; a_evidence; a_store; }

      a_upload -> a_quarantine -> a_worker -> a_evidence -> a_store [
        color="#C98A22"
      ];
    }

    subgraph cluster_turn {
      label="② 在线请求执行（按本轮需求选择来源）";
      labelloc=t;
      labeljust=l;
      fontsize=14;
      fontcolor="#245C93";
      color="#A7C7E6";
      fillcolor="#F8FBFF";
      style="rounded,filled";
      penwidth=1.2;
      margin=16;

      a_prompt [label="文本指令\n+ 本轮附件引用", fillcolor="#FFFFFF", color="#8DB3D9"];
      a_admission [label="Chat API\n绑定消息 / Claim / Fence", fillcolor="#FFFFFF", color="#8DB3D9"];
      a_plan [label="Source-aware Plan\nNONE / RETRIEVAL / DIRECT\n/ DIRECT_AND_RETRIEVAL", fillcolor="#DDEEFF", color="#4D8BC4", penwidth=1.8];

      a_plain [
        label="NONE\n普通文本绘图",
        fillcolor="#F1F5F9",
        color="#94A3B8"
      ];
      a_retrieval [
        label="RETRIEVAL\nPDF / 普通图片 → Hybrid Retrieval\n→ Evidence Bundle",
        fillcolor="#E7F1FC",
        color="#4D8BC4"
      ];
      a_direct [
        label="DIRECT\n流程图图片 → exact pixels\n→ tool-free VLM → verified graph",
        fillcolor="#F0E9FA",
        color="#8160B4"
      ];

      a_compose [
        label="绘图 / 组合\nDIRECT_AND_RETRIEVAL 在此合流",
        fillcolor="#E2F4EA",
        color="#3C9A67",
        penwidth=1.8
      ];
      a_commit [
        label="Citation Guard\n+ Canvas Commit",
        fillcolor="#E8F6EE",
        color="#3C9A67"
      ];
      a_review [
        label="画布渲染截图\nVLM Review / 最多一次安全修复",
        fillcolor="#DDF4EE",
        color="#2F8B74"
      ];
      a_result [
        label="可编辑画布\n+ 可追溯来源",
        fillcolor="#FFFFFF",
        color="#5FA887"
      ];

      { rank=same; a_prompt; a_admission; a_plan; }
      { rank=same; a_plain; a_retrieval; a_direct; }
      { rank=same; a_compose; a_commit; a_review; a_result; }

      a_prompt -> a_admission -> a_plan [color="#3979B7"];
      a_plan -> a_plain [xlabel="无附件依赖", color="#7A8797"];
      a_plan -> a_retrieval [xlabel="依据 PDF / 图片内容", color="#3979B7"];
      a_plan -> a_direct [xlabel="还原这张图片", color="#7553A5"];

      a_plain -> a_compose [color="#7A8797"];
      a_retrieval -> a_compose [color="#3979B7"];
      a_direct -> a_compose [color="#7553A5"];
      a_compose -> a_commit -> a_review -> a_result [color="#338760"];
    }

    // Retrieval uses indexed evidence; Direct reads the authorized exact image artifact and bypasses Pinecone.
    a_store -> a_retrieval [
      xlabel="授权检索",
      style=dashed,
      color="#3979B7",
      constraint=false
    ];
    a_store -> a_direct [
      xlabel="读取 READY 图片原始像素\n（绕过 Pinecone）",
      style=dashed,
      color="#7553A5",
      constraint=false
    ];
  }

  legend [
    shape=plaintext,
    fontsize=11,
    fontcolor="#475569",
    label="关键变化：原绘图与 VLM 复查闭环保留；新增的是安全摄取、来源规划，以及 RETRIEVAL / DIRECT 两条受控输入支路。"
  ];

  // Invisible constraints keep the two comparison panels and their internal lanes vertically stacked.
  b_limit -> a_upload [style=invis, weight=100];
  a_worker -> a_admission [style=invis, weight=100];
  a_result -> legend [style=invis, weight=100];
}
