# Copy this file to .env in the backend project root, then fill in your demo key.
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-5.5
LLM_BASE_URL=https://api.openai.com
LLM_COMPLETIONS_PATH=v1/chat/completions
LLM_EMBEDDINGS_PATH=v1/embeddings

# Draw.io reviewer loop count for demo tuning.
DRAWIO_REVIEW_MAX_ITERATIONS=5

# LangChain4j tests expect the /v1 suffix in their base URL.
LLM_LANGCHAIN_BASE_URL=https://api.openai.com/v1

# Baidu AI Search MCP key (used by the baidu-search tool in agent-draw-io.yml).
BAIDU_SEARCH_API_KEY=your_baidu_search_api_key_here

# Writable directory for user-created/evolving skills (each skill = <dir>/<name>/SKILL.md).
# Hot-reloaded at runtime; leave empty to use only the built-in skills bundled in the jar.
DRAWIO_SKILLS_DIR=

# Local MySQL development database used by docker-compose.yml.
MYSQL_DATABASE=ai_draw_io
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3307
MYSQL_TZ=UTC

# Shared secret required (via X-Admin-Token header) to create PUBLIC platform-wide skills.
# Leave empty to disable creating PUBLIC skills through the API (seed them via SQL instead).
SKILL_ADMIN_TOKEN=
