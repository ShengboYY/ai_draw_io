# Copy this file to .env in the backend project root, then fill in your demo key.
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-5.5
LLM_BASE_URL=https://api.openai.com
LLM_COMPLETIONS_PATH=v1/chat/completions
LLM_EMBEDDINGS_PATH=v1/embeddings

# Stable server-only 32+ byte pepper used to HMAC anonymous workspace credentials.
# Generate a unique production value with: openssl rand -base64 32
ANONYMOUS_WORKSPACE_PEPPER=replace-with-a-stable-random-secret-of-at-least-32-bytes

# Text-only Evaluation agents can use a lower-cost OpenAI-compatible provider such as DeepSeek.
EVAL_TEXT_LLM_API_KEY=your_deepseek_api_key_here
EVAL_TEXT_LLM_MODEL=deepseek-chat
EVAL_TEXT_LLM_BASE_URL=https://api.deepseek.com
EVAL_TEXT_LLM_COMPLETIONS_PATH=v1/chat/completions
# Non-secret provenance marker; bump it when the provider endpoint contract changes.
EVAL_TEXT_LLM_PROVIDER_VERSION=deepseek-api-v1

# Dedicated Evaluation model agents. Drafting is human-reviewed; live Judges stay fail-closed.
ZIPP_EVAL_DRAFT_AGENT_ID=300013
ZIPP_EVAL_DRAFT_MODEL_VERSION=deepseek-chat
ZIPP_EVAL_DRAFT_TEMPERATURE=0
ZIPP_EVAL_JUDGE_AGENT_ID=300014
ZIPP_EVAL_JUDGE_MODEL_VERSION=deepseek-chat
ZIPP_EVAL_JUDGE_TEMPERATURE=0
ZIPP_EVAL_JUDGE_CALIBRATION_APPROVED=false
ZIPP_EVAL_JUDGE_CALIBRATION_VERSION=unconfigured
ZIPP_EVAL_JUDGE_CALIBRATED_VERSION=unconfigured
ZIPP_EVAL_LIVE_ENABLED=false

# Trace Semantic Miner stays fail-closed until its exact model/prompt/schema tuple is reviewed.
ZIPP_EVAL_SEMANTIC_MINER_ENABLED=false
ZIPP_EVAL_SEMANTIC_MINER_CALIBRATION_APPROVED=false
ZIPP_EVAL_SEMANTIC_MINER_AGENT_ID=300015
ZIPP_EVAL_SEMANTIC_MINER_MODEL_VERSION=deepseek-chat
ZIPP_EVAL_SEMANTIC_MINER_TEMPERATURE=0
ZIPP_EVAL_SEMANTIC_MINER_CALIBRATED_VERSION=unconfigured

# Visual agents may use a separate multimodal provider. Omitted VLM values fall back to LLM_*.
# VLM_API_KEY=your_multimodal_provider_key
# VLM_MODEL=your_multimodal_model
# VLM_BASE_URL=https://api.openai.com
# VLM_COMPLETIONS_PATH=v1/chat/completions
ZIPP_VISUAL_REVIEW_ENABLED=false
ZIPP_VISUAL_REVIEW_AUTO_REPAIR_ENABLED=false
ZIPP_VISUAL_REVIEW_DRAWER_AGENT_ID=300000
ZIPP_EVAL_VISUAL_JUDGE_AGENT_ID=300016
ZIPP_EVAL_VISUAL_JUDGE_MODEL_VERSION=unconfigured
ZIPP_EVAL_VISUAL_JUDGE_TEMPERATURE=0
ZIPP_EVAL_VISUAL_JUDGE_CALIBRATION_APPROVED=false
ZIPP_EVAL_VISUAL_JUDGE_CALIBRATION_VERSION=unconfigured
ZIPP_EVAL_VISUAL_JUDGE_CALIBRATED_VERSION=unconfigured
ZIPP_EVAL_VISUAL_MINER_AGENT_ID=300017
ZIPP_EVAL_VISUAL_MINER_ENABLED=false
ZIPP_EVAL_VISUAL_MINER_MODEL_VERSION=unconfigured
ZIPP_EVAL_VISUAL_MINER_TEMPERATURE=0
ZIPP_EVAL_VISUAL_MINER_CALIBRATION_APPROVED=false
ZIPP_EVAL_VISUAL_MINER_CALIBRATED_VERSION=unconfigured

# LangChain4j tests expect the /v1 suffix in their base URL.
LLM_LANGCHAIN_BASE_URL=https://api.openai.com/v1

# Baidu AI Search MCP key (used by the baidu-search tool in agent-draw-io.yml).
BAIDU_SEARCH_API_KEY=your_baidu_search_api_key_here

# Writable directory for user-created/evolving skills (each skill = <dir>/<name>/SKILL.md).
# Hot-reloaded at runtime; leave empty to use only the built-in skills bundled in the jar.
DRAWIO_SKILLS_DIR=

# Local MySQL development database used by docker-compose.yml.
MYSQL_DATABASE=ai_draw_io
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3307
MYSQL_TZ=UTC

# Shared secret required (via X-Admin-Token header) to create PUBLIC platform-wide skills.
# Leave empty to disable creating PUBLIC skills through the API (seed them via SQL instead).
SKILL_ADMIN_TOKEN=
