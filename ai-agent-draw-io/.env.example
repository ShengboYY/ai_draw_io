# Copy this file to .env in the backend project root, then fill in your demo key.
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-5.5
LLM_BASE_URL=https://api.openai.com
LLM_COMPLETIONS_PATH=v1/chat/completions
LLM_EMBEDDINGS_PATH=v1/embeddings

# Draw.io reviewer loop count for demo tuning.
DRAWIO_REVIEW_MAX_ITERATIONS=5

# LangChain4j tests expect the /v1 suffix in their base URL.
LLM_LANGCHAIN_BASE_URL=https://api.openai.com/v1
