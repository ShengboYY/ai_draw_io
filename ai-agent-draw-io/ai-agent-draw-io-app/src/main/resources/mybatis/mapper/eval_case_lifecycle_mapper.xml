<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zipp.ai.infrastructure.dao.IEvalCaseLifecycleMapper">
  <resultMap id="evidence" type="org.zipp.ai.infrastructure.dao.po.evaluation.controlplane.EvalCaseEvidencePO">
    <id property="id" column="id"/>
    <result property="workingCopyId" column="working_copy_id"/>
    <result property="workingCopyRevision" column="working_copy_revision"/>
    <result property="evidenceType" column="evidence_type"/>
    <result property="status" column="status"/>
    <result property="payloadJson" column="payload_json"/>
    <result property="componentVersion" column="component_version"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>
  <resultMap id="review" type="org.zipp.ai.infrastructure.dao.po.evaluation.controlplane.EvalCaseWorkingCopyReviewPO">
    <id property="id" column="id"/>
    <result property="workingCopyId" column="working_copy_id"/>
    <result property="workingCopyRevision" column="working_copy_revision"/>
    <result property="reviewerUserId" column="reviewer_user_id"/>
    <result property="decision" column="decision"/>
    <result property="reason" column="reason"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>
  <insert id="insertEvidence">
    insert into eval_case_evidence
      (id,working_copy_id,working_copy_revision,evidence_type,status,payload_json,component_version,created_at)
    values
      (#{id},#{workingCopyId},#{workingCopyRevision},#{evidenceType},#{status},#{payloadJson},#{componentVersion},#{createdAt})
  </insert>
  <select id="selectEvidence" resultMap="evidence">
    select * from eval_case_evidence where working_copy_id=#{workingCopyId} order by created_at asc, id asc
  </select>
  <insert id="insertReview">
    insert into eval_case_working_copy_review
      (id,working_copy_id,working_copy_revision,reviewer_user_id,decision,reason,created_at)
    values
      (#{id},#{workingCopyId},#{workingCopyRevision},#{reviewerUserId},#{decision},#{reason},#{createdAt})
  </insert>
  <select id="selectReviews" resultMap="review">
    select * from eval_case_working_copy_review where working_copy_id=#{workingCopyId} order by created_at asc, id asc
  </select>
</mapper>
