        "minVertices": 3,
        "minEdges": 2,
        "requiredLabels": [
          "Gateway",
          "Worker",
          "Audit Store"
        ]
      },
      "citationAssertions": {
        "minimumCitations": 3,
        "mustCiteAnchors": [
          "rg-gateway",
          "rg-worker",
          "rg-audit-store"
        ]
      },
      "claimAssertions": {
        "requiredClaims": [
          {
            "claimId": "rg-gateway",
            "description": "Approved deployment responsibility: Gateway validates ingress and forwards approved traffic to Worker.",
            "requiresCitation": true
          },
          {
            "claimId": "rg-worker",
            "description": "Approved deployment responsibility: Worker executes the release workload after Gateway validation.",
            "requiresCitation": true
          },
          {
            "claimId": "rg-audit-store",
            "description": "Approved deployment responsibility: Audit Store records the immutable release audit event from Worker.",
            "requiresCitation": true
          }
        ]
      }
