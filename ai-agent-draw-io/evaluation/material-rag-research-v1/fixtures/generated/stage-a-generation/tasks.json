      "type": "stage_a_grounded_01",
      "request": "Create an editable deployment architecture using the approved gateway, worker, and audit-store responsibilities in the release guide.",
      "requiredAnchors": [
        "rg-gateway",
        "rg-worker",
        "rg-audit-store"
      ],
