# macOS local files
.DS_Store

# Editor and IDE metadata
.idea/
.vscode/
*.iws
*.iml
*.ipr
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Local environment files and secrets
.env
.env.*
!.env.example
*.local
.local-config
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Spring Boot profile configs that commonly contain local credentials
application-local.yml
application-local.yaml
application-local.properties
application-*.local.yml
application-*.local.yaml
application-*.local.properties
application-dev.yml
application-dev.yaml
application-test.yml
application-test.yaml
application-prod.yml
application-prod.yaml

# Agent runtime configs may contain API keys/private endpoints -> keep ignored,
# EXCEPT the active prompts file agent-draw-io.yml, which reads its secret
# (BAIDU_SEARCH_API_KEY) from .env so it carries no keys and is version-controlled.
**/src/main/resources/agent/*.yml
**/src/main/resources/agent/*.yaml
!**/src/main/resources/agent/agent-draw-io.yml

# Local API smoke-test scripts may contain Authorization headers
**/docs/dev-ops/api/gpt.sh
**/docs/dev-ops/api/*.local.sh
!**/docs/dev-ops/api/*.example.sh

# Java and Maven build outputs
target/
*.class
*.jar
*.war
*.ear

# Keep Maven wrapper jars if a wrapper is added later
!.mvn/wrapper/maven-wrapper.jar

# Node and Next.js dependencies/build outputs
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Package manager and runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Project runtime data generated locally
data/
**/data/

# Tooling caches and deployment state
.cache/
.eslintcache
.turbo/
.vercel/

# Local agent scratch/runtime state
.superpowers/
